# Docker Compose 所需的 PostgreSQL 密码，使用前更换。
POSTGRES_PASSWORD=replace_with_local_postgres_password

# zoowy 账号凭据加密。运行以下命令生成 32 字节随机密钥。
# node -p "require('node:crypto').randomBytes(32).toString('base64')"
DEEPSEEK_CREDENTIAL_KEY=

# 服务端后台 AI 工作流可选配置。用户在 zoowy 内另行设置自己的 API Key。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
